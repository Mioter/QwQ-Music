<Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Margin="0,10"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:QwQ_Music.ViewModels.Pages"
      xmlns:u="https://irihi.tech/ursa"
      xmlns:anchorControl="clr-namespace:QwQ_Music.UI.Controls.AnchorControl"
      x:DataType="pages:SystemConfigPageViewModel"
      x:Class="QwQ_Music.Views.Pages.SystemConfigPage">

    <u:SelectionList Grid.Column="0" Name="NavigationList">

        <TextBlock Text="程序" />
        <TextBlock Text="日志" IsEnabled="{CompiledBinding Config.IsDebugMode}" />

    </u:SelectionList>

    <anchorControl:Anchor Grid.Column="1" IndexSource="{CompiledBinding ElementName=NavigationList}">

        <anchorControl:Anchor.Styles>

            <Style Selector="StackPanel">
                <Setter Property="Spacing" Value="10" />
            </Style>

        </anchorControl:Anchor.Styles>

        <anchorControl:Anchor.HeaderTemplate>

            <DataTemplate DataType="x:String">
                <Panel>
                    <TextBlock FontSize="16" Text="{CompiledBinding}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Separator VerticalAlignment="Bottom" Margin="0" />
                </Panel>
            </DataTemplate>

        </anchorControl:Anchor.HeaderTemplate>

        <anchorControl:AnchorItem Header="程序">

            <StackPanel>
                <CheckBox
                    Content="启动时播放"
                    IsChecked="{CompiledBinding Config.IsPlayOnStart}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="语言" />
                    <TextBlock Text="* 需要重启程序" Foreground="{DynamicResource  TextBlockTertiaryForeground}" />
                </StackPanel>
                <ComboBox HorizontalAlignment="Right"
                          ItemsSource="{CompiledBinding Lang.AvailableLanguages }"
                          DisplayMemberBinding="{CompiledBinding Value}"
                          SelectedValueBinding="{CompiledBinding Key}"
                          SelectedValue="{CompiledBinding Config.Language}" />
                <CheckBox
                    Content="播放时阻止系统睡眠"
                    IsChecked="{CompiledBinding Config.KeepSystemAwake}" />
                <CheckBox
                    Margin="24 0 0 0"
                    Content="同时保持显示器开启"
                    IsEnabled="{CompiledBinding Config.KeepSystemAwake}"
                    IsChecked="{CompiledBinding Config.KeepDisplay}" />
                <Panel>
                    <TextBlock Text="在窗口关闭时" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Right"
                              ItemsSource="{CompiledBinding ClosingBehaviors}"
                              DisplayMemberBinding="{CompiledBinding Key}"
                              SelectedValueBinding="{CompiledBinding Value}"
                              SelectedValue="{CompiledBinding Config.ClosingBehavior}" />
                </Panel>

                <CheckBox
                    Content="开发者模式"
                    IsChecked="{CompiledBinding Config.IsDebugMode}" />

            </StackPanel>

        </anchorControl:AnchorItem>

        <anchorControl:AnchorItem Header="日志" IsEnabled="{CompiledBinding Config.IsDebugMode}">

            <StackPanel>

                <Panel>
                    <TextBlock Text="过滤级别" VerticalAlignment="Center" />
                    <ComboBox
                        MinWidth="80"
                        HorizontalAlignment="Right"
                        ItemsSource="{CompiledBinding LogLevels}"
                        DisplayMemberBinding="{CompiledBinding Key}"
                        SelectedValueBinding="{CompiledBinding Value}"
                        SelectedValue="{CompiledBinding LoggerServiceConfig.Level}" />
                </Panel>

                <TextBlock Text="重试次数" />
                <u:NumericIntUpDown Minimum="0" Maximum="10"
                                    Value="{CompiledBinding LoggerServiceConfig.RetryCount}" />

            </StackPanel>

        </anchorControl:AnchorItem>


    </anchorControl:Anchor>

</Grid>