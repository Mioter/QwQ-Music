<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QwQ_Music.ViewModels.Pages"
             xmlns:customs="clr-namespace:QwQ_Music.Views.Customs"
             x:DataType="vm:MusicLibraryPageViewModel"
             x:Class="QwQ_Music.Views.Pages.MusicLibraryPage">
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <customs:MusicListDataGrid Height="{CompiledBinding $parent.Bounds.Height}" DataContext="{CompiledBinding }" />
    </Border>
</UserControl>