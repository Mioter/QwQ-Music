<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:QwQ_Music.UI.Behaviors"
        xmlns:managers="clr-namespace:QwQ_Music.Common.Managers"
        xmlns:customs="clr-namespace:QwQ_Music.Views.Customs">
    <Style Selector="customs|MusicPlayButton">
        <Setter Property="Template">
            <ControlTemplate x:DataType="managers:AudioPlayManager">
                <Button HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="None"
                        Command="{CompiledBinding Instance.TogglePlayStateCommand}"
                        behaviors:DynamicCornerBehavior.IsEnabled="True">
                    <Panel>
                        <Border
                            Background="#FF51C5FF"
                            Classes.Reduction="{TemplateBinding IsPointerOver}"
                            Classes.Run="{TemplateBinding IsPointerOver}"
                            ClipToBounds="True"
                            Padding="{TemplateBinding Padding,Mode=TwoWay}"
                            behaviors:DynamicCornerBehavior.IsEnabled="True">
                            <Border.RenderTransform>
                                <RotateTransform Angle="{TemplateBinding Angle, Mode=TwoWay}" />
                            </Border.RenderTransform>

                            <Border.Styles>

                                <Style Selector="Border.Reduction">
                                    <Style.Animations>
                                        <Animation
                                            Duration="0:0:1"
                                            Easing="QuadraticEaseIn"
                                            FillMode="Forward">
                                            <KeyFrame Cue="0%" KeySpline="0.3,1.3,1,0.13">
                                                <Setter Property="RotateTransform.Angle"
                                                        Value="{TemplateBinding Angle}" />
                                                <Setter Property="Padding" Value="{TemplateBinding Padding}" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%" KeySpline="0.3,1.3,1,1.13">
                                                <Setter Property="RotateTransform.Angle" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>

                                <Style Selector="Border.Run">
                                    <Style.Animations>
                                        <Animation
                                            Duration="0:0:1"
                                            Easing="QuadraticEaseIn"
                                            FillMode="Forward">
                                            <KeyFrame Cue="0%" KeySpline="0.3,1.3,1,0.13">
                                                <Setter Property="RotateTransform.Angle"
                                                        Value="{TemplateBinding Angle}" />
                                                <Setter Property="Padding" Value="{TemplateBinding Padding}" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%" KeySpline="0.3,1.3,1,1.13">
                                                <Setter Property="RotateTransform.Angle" Value="180" />
                                                <Setter Property="Padding" Value="5" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>

                            </Border.Styles>

                            <Ellipse Fill="#FF7BE0FF" Margin="3">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-8" Y="8" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                        </Border>
                        <PathIcon
                            Foreground="White"
                            Height="30"
                            Width="30">
                            <Interaction.Behaviors>
                                <IfElseTrigger Condition="{CompiledBinding Instance.IsPlaying}">
                                    <IfElseTrigger.IfActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static PathIcon.DataProperty}"
                                            Value="{StaticResource PauseIconData}" />
                                    </IfElseTrigger.IfActions>
                                    <IfElseTrigger.ElseActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static PathIcon.DataProperty}"
                                            Value="{StaticResource PlayIconData}" />
                                    </IfElseTrigger.ElseActions>
                                </IfElseTrigger>
                            </Interaction.Behaviors>
                        </PathIcon>
                    </Panel>
                    <ToolTip.Tip>
                        <TextBlock>
                            <Interaction.Behaviors>
                                <IfElseTrigger Condition="{CompiledBinding Instance.IsPlaying}">
                                    <IfElseTrigger.IfActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static TextBlock.TextProperty}"
                                            Value="暂停⏸️" />
                                    </IfElseTrigger.IfActions>
                                    <IfElseTrigger.ElseActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static TextBlock.TextProperty}"
                                            Value="播放▶️" />
                                    </IfElseTrigger.ElseActions>
                                </IfElseTrigger>
                            </Interaction.Behaviors>
                        </TextBlock>
                    </ToolTip.Tip>
                </Button>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>