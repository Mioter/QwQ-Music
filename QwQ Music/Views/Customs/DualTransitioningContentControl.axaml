<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QwQ_Music.Views.Customs">

    <Style Selector="controls|DualTransitioningContentControl">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas x:Name="PART_Container"/>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>