<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:QwQ_Music.UI.Behaviors"
             xmlns:utilities="clr-namespace:QwQ_Music.Common.Utilities"
             xmlns:panelVms="clr-namespace:QwQ_Music.ViewModels.Panels"
             xmlns:models="clr-namespace:QwQ_Music.Models"
             xmlns:pages="clr-namespace:QwQ_Music.Views.Pages"
             x:DataType="panelVms:AllMusicListsPanelViewModel"
             x:Class="QwQ_Music.Views.Panels.AllMusicListsPanel"
             Name="AllMusicListsContainer">
    <Carousel SelectedIndex="{CompiledBinding CurrentStatus}">
        <Carousel.PageTransition>
            <CompositePageTransition>
                <CrossFade Duration="0:0:0.5" />
                <PageSlide Duration="0:0:0.3"
                           Orientation="Vertical"
                           SlideInEasing="QuadraticEaseIn"
                           SlideOutEasing="QuadraticEaseOut" />
            </CompositePageTransition>
        </Carousel.PageTransition>
        <Carousel.Items>
            <Grid RowDefinitions="Auto,*" Margin="0,10" RowSpacing="5">
                <Panel Grid.Row="0">
                    <Button CornerRadius="8" HorizontalAlignment="Left"
                            Theme="{StaticResource OutlineButton}"
                            Margin="10,5"
                            Command="{CompiledBinding MusicListsManager.CreateMusicListCommand}"
                            Content="新建歌单" />

                    <TextBox CornerRadius="15"
                             Margin="10,0"
                             HorizontalAlignment="Right"
                             Text="{CompiledBinding SearchText, Mode=TwoWay}"
                             PlaceholderText="搜索歌单"
                             Width="200">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource SemiIconSearchStroked}" Height="14" Width="14" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Panel>
                <Border Grid.Row="1">
                    <ScrollViewer Width="{CompiledBinding $parent.Bounds.Width}" Height="{CompiledBinding $parent.Bounds.Height}">
                        <ItemsRepeater Margin="10 5" Background="Transparent"
                                       ItemsSource="{CompiledBinding FilteredList,Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.Styles>

                                <Style Selector="ItemsControl > ContentPresenter">

                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Duration="0:0:0.2"
                                                                           Property="RenderTransform" />
                                        </Transitions>
                                    </Setter>

                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu x:DataType="models:MusicListModel">

                                                <MenuItem
                                                    Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).PlayCurrentListCommand}"
                                                    CommandParameter="{CompiledBinding }"
                                                    Header="播放">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource SemiIconPlay}" Margin="4" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Header="编辑">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource SemiIconEdit}"
                                                                  Margin="2" />
                                                    </MenuItem.Icon>

                                                    <MenuItem
                                                        Header="图标"
                                                        Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).MusicListsManager.EditMusicListCoverCommand}"
                                                        CommandParameter="{CompiledBinding }">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconImage}"
                                                                      Margin="2" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>

                                                    <MenuItem
                                                        Header="名称"
                                                        Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).MusicListsManager.EditMusicListNameCommand}"
                                                        CommandParameter="{CompiledBinding }">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconFontColor}"
                                                                      Margin="2" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>

                                                    <MenuItem
                                                        Header="描述"
                                                        Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).MusicListsManager.EditMusicListDescriptionCommand}"
                                                        CommandParameter="{CompiledBinding }">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconFontColor}"
                                                                      Margin="2" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>

                                                </MenuItem>

                                                <MenuItem
                                                    Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).MusicListsManager.DeleteMusicListCommand}"
                                                    CommandParameter="{CompiledBinding }"
                                                    Header="删除">
                                                    <MenuItem.Icon>
                                                        <PathIcon Foreground="{DynamicResource SemiRed5}"
                                                                  Data="{StaticResource SemiIconDelete}"
                                                                  Margin="2" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style Selector="ItemsControl > ContentPresenter:pointerover">
                                    <Setter Property="RenderTransform" Value="translateY(-10px)" />
                                </Style>

                            </ItemsRepeater.Styles>
                            <ItemsRepeater.ItemTemplate>

                                <DataTemplate>

                                    <Panel Margin="5" DragDrop.AllowDrop="True">

                                        <Border CornerRadius="12"
                                                Classes.Pointerover="{CompiledBinding $parent[Panel].IsPointerOver}"
                                                Classes.NoPointerover="{CompiledBinding !$parent[Panel].IsPointerOver}">

                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.98" />
                                                    <TranslateTransform Y="5" />
                                                </TransformGroup>
                                            </Border.RenderTransform>

                                            <Border.Transitions>
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                                                </Transitions>
                                            </Border.Transitions>

                                            <Border.Effect>
                                                <BlurEffect Radius="20" />
                                            </Border.Effect>

                                            <Border.Styles>

                                                <Style Selector="Border.NoPointerover">
                                                    <Setter Property="Background" Value="{DynamicResource SemiGrey2}" />
                                                </Style>

                                                <Style Selector="Border.Pointerover">

                                                    <Setter Property="Background">
                                                        <LinearGradientBrush>
                                                            <GradientStop Offset="0" Color="#886094EA" />
                                                            <GradientStop Offset="1" Color="#88F02FC2" />
                                                        </LinearGradientBrush>
                                                    </Setter>

                                                    <Style.Animations>
                                                        <Animation
                                                            Duration="0:0:3"
                                                            FillMode="Forward"
                                                            IterationCount="Infinite">
                                                            <KeyFrame Cue="0%">
                                                                <Setter
                                                                    Property="behaviors:BorderLinearGradientBrushBehavior.BackgroundRotateAngle"
                                                                    Value="0" />
                                                            </KeyFrame>
                                                            <KeyFrame Cue="100%">
                                                                <Setter
                                                                    Property="behaviors:BorderLinearGradientBrushBehavior.BackgroundRotateAngle"
                                                                    Value="360" />
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>

                                            </Border.Styles>
                                        </Border>

                                        <Button Padding="10"
                                                BorderThickness="2"
                                                Foreground="{DynamicResource TextBlockDefaultForeground}"
                                                CornerRadius="12"
                                                Background="{DynamicResource SemiColorBackground2}"
                                                Command="{CompiledBinding #AllMusicListsContainer.((panelVms:AllMusicListsPanelViewModel)DataContext).SelectMusicListCommand}"
                                                CommandParameter="{CompiledBinding }">

                                            <Button.Styles>
                                                <Style Selector="Button">

                                                    <Style
                                                        Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource SemiColorBackground2}" />
                                                    </Style>

                                                    <Style
                                                        Selector="^:focus /template/ ContentPresenter#PART_ContentPresenter">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource SemiColorBackground2}" />
                                                    </Style>

                                                </Style>
                                            </Button.Styles>

                                            <DockPanel
                                                Height="70"
                                                Width="180"
                                                HorizontalSpacing="10">

                                                <Border DockPanel.Dock="Left"
                                                        CornerRadius="12"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Top">

                                                    <Image Source="{CompiledBinding Thumbnail}"
                                                           IsVisible="{CompiledBinding IsCoverExist}" />

                                                </Border>

                                                <StackPanel DockPanel.Dock="Top" Spacing="5">

                                                    <TextBlock
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{CompiledBinding Name}" />

                                                    <Separator Margin="0" />

                                                    <TextBlock DockPanel.Dock="Bottom"
                                                               Text="{CompiledBinding Description}"
                                                               MaxLines="2"
                                                               FontSize="12"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               Classes="Tertiary" />

                                                </StackPanel>

                                            </DockPanel>

                                        </Button>

                                        <PathIcon Data="{StaticResource SemiIconBookmark}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Foreground="{x:Static utilities:ColorGenerator.RandomColor}"
                                                  Height="15">
                                            <PathIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="135" />
                                                    <TranslateTransform X="-3" Y="-3" />
                                                </TransformGroup>
                                            </PathIcon.RenderTransform>
                                        </PathIcon>

                                    </Panel>

                                </DataTemplate>

                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Border>
            </Grid>
            <pages:MusicListInfoPage DataContext="{CompiledBinding }" />
        </Carousel.Items>
    </Carousel>
</UserControl>