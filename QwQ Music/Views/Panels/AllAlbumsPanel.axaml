<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:QwQ_Music.Models"
    xmlns:panels="clr-namespace:QwQ_Music.ViewModels.Panels"
    xmlns:pages="clr-namespace:QwQ_Music.Views.Pages"
    x:DataType="panels:AllAlbumsPanelViewModel"
    x:Class="QwQ_Music.Views.Panels.AllAlbumsPanel"
    Name="AllAlbumsContainer">
    <Carousel SelectedIndex="{CompiledBinding CurrentState}">
        <Carousel.PageTransition>
            <CompositePageTransition>
                <CrossFade Duration="0:0:0.5" />
                <PageSlide Duration="0:0:0.3"
                           Orientation="Vertical"
                           SlideInEasing="QuadraticEaseIn"
                           SlideOutEasing="QuadraticEaseOut" />
            </CompositePageTransition>
        </Carousel.PageTransition>
        <Carousel.Items>
            <Grid RowDefinitions="Auto,*" Margin="0,10" RowSpacing="5">
                <Panel Grid.Row="0">
                    <Border HorizontalAlignment="Left"
                            Margin="20 5" Theme="{StaticResource RadioButtonGroupBorder}" CornerRadius="8">
                        <!-- 卡片样式选择 -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="CardSimple" IsChecked="{CompiledBinding StyleConfig.AlbumCard[0]}"
                                         Theme="{DynamicResource ButtonRadioButton}">
                                简约
                            </RadioButton>
                            <RadioButton Name="CardFancy" IsChecked="{CompiledBinding StyleConfig.AlbumCard[1]}"
                                         Theme="{DynamicResource ButtonRadioButton}">
                                梦幻
                            </RadioButton>
                            <RadioButton Name="CardMini" IsChecked="{CompiledBinding StyleConfig.AlbumCard[2]}"
                                         Theme="{DynamicResource ButtonRadioButton}">
                                迷你
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <TextBox CornerRadius="15"
                             Margin="10,0"
                             HorizontalAlignment="Right"
                             Text="{CompiledBinding SearchText, Mode=TwoWay}"
                             PlaceholderText="搜索专辑"
                             Width="200">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource SemiIconSearchStroked}" Height="14" Width="14" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Panel>
                <Border Grid.Row="1">
                    <ScrollViewer Width="{CompiledBinding $parent.Bounds.Width}" Height="{CompiledBinding $parent.Bounds.Height}">
                        <ItemsRepeater Margin="10 5" Background="Transparent" ItemsSource="{CompiledBinding FilteredList}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.Styles>

                                <Style Selector="ItemsControl > ContentPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>

                                                <MenuItem
                                                    Command="{CompiledBinding #AllAlbumsContainer.((panels:AllAlbumsPanelViewModel)DataContext).PlayAlbumMusicCommand}"
                                                    CommandParameter="{CompiledBinding}"
                                                    Header="播放">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource SemiIconPlay}" Margin="4" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>

                                </Style>

                            </ItemsRepeater.Styles>
                            <Interaction.Behaviors>
                                <IfElseTrigger Condition="{CompiledBinding #CardSimple.IsChecked}">

                                    <IfElseTrigger.IfActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static ItemsControl.ItemTemplateProperty}">
                                            <ChangeAvaloniaPropertyAction.Value>
                                                <DataTemplate x:DataType="models:AlbumModel">

                                                    <Button CornerRadius="12"
                                                            Padding="20"
                                                            Margin="10"
                                                            FontWeight="Normal"
                                                            Foreground="{DynamicResource TextBlockDefaultForeground}"
                                                            Background="{DynamicResource SemiColorBackground2}"
                                                            Command="{CompiledBinding #AllAlbumsContainer.((panels:AllAlbumsPanelViewModel)DataContext).SelectAlbumCommand}"
                                                            CommandParameter="{CompiledBinding}">

                                                        <Button.Transitions>
                                                            <Transitions>
                                                                <EffectTransition Duration="0:0:0.3"
                                                                        Property="Effect" />
                                                            </Transitions>
                                                        </Button.Transitions>

                                                        <Button.Styles>
                                                            <Style Selector="Button">

                                                                <Style
                                                                    Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>

                                                                <Style
                                                                    Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>
                                                            </Style>

                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Effect"
                                                                        Value="{DynamicResource LightColor0DropShadowEffect}" />
                                                            </Style>

                                                        </Button.Styles>

                                                        <Grid Height="120" Width="240" RowDefinitions="3*,2*"
                                                              ColumnDefinitions="Auto,Auto,*"
                                                              RowSpacing="10" ColumnSpacing="10">
                                                            <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="8"
                                                                    VerticalAlignment="Top"
                                                                    Height="60" Width="60"
                                                                    ClipToBounds="True">
                                                                <Image Source="{CompiledBinding Thumbnail}" />
                                                            </Border>

                                                            <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                       Fill="{DynamicResource SemiColorFill2}"
                                                                       Width="1" />

                                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                                       Text="{CompiledBinding Name}"
                                                                       FontWeight="Bold" TextWrapping="Wrap"
                                                                       MaxLines="3" />
                                                            <TextBlock Grid.Row="1" Grid.Column="2"
                                                                       Text="{CompiledBinding Artists}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Classes="Tertiary"
                                                                       MaxLines="2" />
                                                        </Grid>
                                                    </Button>

                                                </DataTemplate>
                                            </ChangeAvaloniaPropertyAction.Value>
                                        </ChangeAvaloniaPropertyAction>
                                    </IfElseTrigger.IfActions>

                                </IfElseTrigger>

                                <IfElseTrigger Condition="{CompiledBinding #CardFancy.IsChecked}">

                                    <IfElseTrigger.IfActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static ItemsControl.ItemTemplateProperty}">
                                            <ChangeAvaloniaPropertyAction.Value>
                                                <DataTemplate x:DataType="models:AlbumModel">
                                                    <Button CornerRadius="12"
                                                            Margin="10"
                                                            Padding="0"
                                                            FontWeight="Normal"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource TextBlockDefaultForeground}"
                                                            Background="{DynamicResource SemiColorBackground2}"
                                                            Command="{CompiledBinding #AllAlbumsContainer.((panels:AllAlbumsPanelViewModel)DataContext).SelectAlbumCommand}"
                                                            CommandParameter="{CompiledBinding}">

                                                        <Button.Transitions>
                                                            <Transitions>
                                                                <EffectTransition Duration="0:0:0.3"
                                                                        Property="Effect" />
                                                            </Transitions>
                                                        </Button.Transitions>

                                                        <Button.Styles>
                                                            <Style Selector="Button">

                                                                <Style
                                                                    Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>

                                                                <Style
                                                                    Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>
                                                            </Style>

                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Effect"
                                                                        Value="{DynamicResource LightColor0DropShadowEffect}" />
                                                            </Style>

                                                            <Style Selector="Button.Current">
                                                                <Setter Property="Effect">
                                                                    <DropShadowEffect OffsetX="0" OffsetY="0"
                                                                            Color="{DynamicResource SemiPurple2Color}"
                                                                            BlurRadius="10" />
                                                                </Setter>
                                                            </Style>

                                                        </Button.Styles>

                                                        <Border CornerRadius="12" ClipToBounds="True">

                                                            <Panel>

                                                                <Panel>
                                                                    <Panel.Background>
                                                                        <ImageBrush Stretch="UniformToFill"
                                                                                Source="{CompiledBinding Thumbnail}" />
                                                                    </Panel.Background>

                                                                    <Panel.Effect>
                                                                        <BlurEffect Radius="30" />
                                                                    </Panel.Effect>

                                                                </Panel>

                                                                <Grid Height="120" Width="240"
                                                                      ColumnDefinitions="Auto,*">

                                                                    <Border Grid.Column="0" Grid.Row="0"
                                                                            CornerRadius="8"
                                                                            VerticalAlignment="Top"
                                                                            Margin="10"
                                                                            Height="60" Width="60"
                                                                            ClipToBounds="True">

                                                                        <Image Source="{CompiledBinding Thumbnail}" />
                                                                    </Border>

                                                                    <Grid Grid.Column="1" RowDefinitions="3*,2*">

                                                                        <Panel Grid.RowSpan="2"
                                                                               Background="{DynamicResource SemiColorBackground2}"
                                                                               Opacity="0.8" />

                                                                        <TextBlock Grid.Row="0"
                                                                                Margin="10,10,10,0"
                                                                                Text="{CompiledBinding Name}"
                                                                                FontWeight="Bold" TextWrapping="Wrap"
                                                                                MaxLines="3" />

                                                                        <TextBlock Grid.Row="1"
                                                                                Margin="10,0,10,10"
                                                                                Text="{CompiledBinding Artists}"
                                                                                TextWrapping="Wrap"
                                                                                FontSize="12"
                                                                                Classes="Tertiary"
                                                                                MaxLines="2" />
                                                                    </Grid>

                                                                </Grid>

                                                            </Panel>

                                                        </Border>


                                                    </Button>
                                                </DataTemplate>
                                            </ChangeAvaloniaPropertyAction.Value>
                                        </ChangeAvaloniaPropertyAction>
                                    </IfElseTrigger.IfActions>

                                </IfElseTrigger>

                                <IfElseTrigger Condition="{CompiledBinding #CardMini.IsChecked}">

                                    <IfElseTrigger.IfActions>
                                        <ChangeAvaloniaPropertyAction
                                            TargetProperty="{x:Static ItemsControl.ItemTemplateProperty}">
                                            <ChangeAvaloniaPropertyAction.Value>
                                                <DataTemplate x:DataType="models:AlbumModel">
                                                    <Button CornerRadius="12"
                                                            Margin="10"
                                                            Padding="0"
                                                            FontWeight="Normal"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource TextBlockDefaultForeground}"
                                                            Background="{DynamicResource SemiColorBackground2}"
                                                            Command="{CompiledBinding #AllAlbumsContainer.((panels:AllAlbumsPanelViewModel)DataContext).SelectAlbumCommand}"
                                                            CommandParameter="{CompiledBinding}">
                                                        <Button.Transitions>
                                                            <Transitions>
                                                                <EffectTransition Duration="0:0:0.3"
                                                                        Property="Effect" />
                                                            </Transitions>
                                                        </Button.Transitions>

                                                        <Button.Styles>
                                                            <Style Selector="Button">

                                                                <Style
                                                                    Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>

                                                                <Style
                                                                    Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SemiColorBackground2}" />
                                                                </Style>
                                                            </Style>

                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Effect"
                                                                        Value="{DynamicResource LightColor0DropShadowEffect}" />
                                                            </Style>

                                                            <Style Selector="Button.Current">
                                                                <Setter Property="Effect">
                                                                    <DropShadowEffect OffsetX="0" OffsetY="0"
                                                                            Color="{DynamicResource SemiPurple2Color}"
                                                                            BlurRadius="10" />
                                                                </Setter>
                                                            </Style>

                                                        </Button.Styles>

                                                        <Border CornerRadius="12" ClipToBounds="True">

                                                            <Panel>

                                                                <Panel>
                                                                    <Panel.Background>
                                                                        <ImageBrush Stretch="UniformToFill"
                                                                                Source="{CompiledBinding Thumbnail}" />
                                                                    </Panel.Background>

                                                                    <Panel.Effect>
                                                                        <BlurEffect Radius="10" />
                                                                    </Panel.Effect>

                                                                </Panel>

                                                                <Grid Height="60" Width="240" ColumnDefinitions="60,*">

                                                                    <Image Source="{CompiledBinding Thumbnail}" />

                                                                    <Grid Grid.Column="1" RowDefinitions="3*,2*">

                                                                        <Panel Grid.RowSpan="2"
                                                                               Background="{DynamicResource SemiColorBackground2}"
                                                                               Opacity="0.9" />

                                                                        <TextBlock Grid.Row="0"
                                                                                Margin="10,10,10,0"
                                                                                Text="{CompiledBinding Name}"
                                                                                FontWeight="Bold" TextWrapping="Wrap"
                                                                                MaxLines="3" />

                                                                        <TextBlock Grid.Row="1"
                                                                                Margin="10,0,10,10"
                                                                                Text="{CompiledBinding Artists}"
                                                                                TextWrapping="Wrap"
                                                                                Classes="Tertiary"
                                                                                FontSize="12"
                                                                                MaxLines="2" />
                                                                    </Grid>

                                                                </Grid>

                                                            </Panel>

                                                        </Border>


                                                    </Button>
                                                </DataTemplate>
                                            </ChangeAvaloniaPropertyAction.Value>
                                        </ChangeAvaloniaPropertyAction>
                                    </IfElseTrigger.IfActions>

                                </IfElseTrigger>
                            </Interaction.Behaviors>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Border>
            </Grid>

            <pages:AlbumInfoPage DataContext="{CompiledBinding .,Mode=OneWay}" />
        </Carousel.Items>
    </Carousel>
</UserControl>